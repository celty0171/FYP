# Production-layer configuration. Copy to `.env` at the repo root and fill in.
# `.env` is gitignored — never commit real secrets.

# ---- Data source ----------------------------------------------------------
# postgres (default) connects to a live DB; json uses the bundled offline Mondial files.
VIZER_DATASOURCE=postgres

# Live PostgreSQL: either a full URL...
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mondial
# ...or discrete parts (used only if DATABASE_URL is empty). Load Mondial first with
# `python experiments/scripts/load_mondial_postgres.py` (see README).
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=mondial

# Max rows fetched per table from a live DB (safety cap).
VIZER_ROW_CAP=5000

# ---- Natural-language front end (Alibaba Cloud Bailian / DashScope) --------
# OpenAI-compatible endpoint. Get a key from the Bailian console.
DASHSCOPE_API_KEY=
# Default public endpoint; for a workspace endpoint use e.g.
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Model for NL->selection parsing, e.g. qwen-plus / qwen-max / qwen-turbo
NL_MODEL=qwen-plus

# ---- LLM chart selection (Step 2) -----------------------------------------
# When on (and DASHSCOPE_API_KEY is set), an LLM ranks the deterministic Step-2
# candidates and picks the one to highlight, with a short English rationale and
# optional dimension-matched mapping tweaks. off (default) keeps Step 2 fully
# deterministic, so the experiment path is byte-identical. Falls back to the
# deterministic pick on any error / missing key. Reuses NL_MODEL by default.
VIZER_LLM_STEP2=off
# VIZER_STEP2_MODEL=qwen-plus
