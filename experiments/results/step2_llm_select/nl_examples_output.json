    {
      "id": "nl5_relationship",
      "query": "Show which countries border each other and how long each border is",
      "targets": "borders · relationship/flow (many-many) → sankey/chord",
      "parsed_table": "borders",
      "parsed_columns": [
        "country1",
        "country2",
        "length"
      ],
      "pattern": "reflexive_many_many_relationship",
      "candidates": [
        "chord diagram",
        "matrix heatmap",
        "force graph",
        "arc diagram"
      ],
      "rule_pick": "chord diagram",
      "llm": {
        "recommended_chart": "chord diagram",
        "reason": "A chord diagram clearly displays the network of borders between countries while using ribbon width to accurately represent the scalar border lengths.",
        "ranking": [
          {
            "chart": "chord diagram",
            "note": "Best for showing weighted connections between many nodes; ribbon width effectively encodes border length."
          },
          {
            "chart": "matrix heatmap",
            "note": "Shows every pair without crossings, but the sparse density (1.1%) makes the matrix mostly empty and hard to read."
          },
          {
            "chart": "force graph",
            "note": "Good for revealing topology and clusters, but edge thickness is less precise for comparing exact border lengths than rib"
          },
          {
            "chart": "arc diagram",
            "note": "Requires a meaningful 1D ordering of countries, which is absent, making the arcs messy and hard to interpret."
          }
        ],
        "mapping": {
          "table": "borders",
          "source": "country1",
          "target": "country2",
          "width": "length",
          "pattern": "reflexive_many_many_relationship"
        },
        "source": "llm"
      }
    },
