{
  "dataset": "Mondial",
  "design_baseline": "Mohammed Hannan, VizER MEng Final Report 2024, Sections 3.2-3.4 and 5.1",
  "source_schema": "C:/Users/ROG/Desktop/fyp/mondial_schema.sql",
  "cases": [
    {
      "id": "hannan_basic_country_bar",
      "mode": "data_first",
      "selected_table": "country",
      "selected_columns": ["code", "population"],
      "expected_pattern": "basic_entity",
      "expected_visualisations": ["bar_chart", "choropleth_map", "word_cloud"],
      "expected_mapping": {
        "key": "country.code",
        "measure": "country.population",
        "bar_label": "country.code",
        "bar_value": "country.population"
      },
      "expected_reasoning": "No selected column is a foreign key. The selected primary key identifies country instances and population is scalar."
    },
    {
      "id": "hannan_basic_inherited_economy_scatter",
      "mode": "data_first",
      "selected_table": "economy",
      "selected_columns": ["country", "gdp", "unemployment"],
      "expected_pattern": "basic_entity_inherited_key",
      "expected_visualisations": ["scatter_chart"],
      "expected_mapping": {
        "key": "economy.country",
        "x": "economy.gdp",
        "y": "economy.unemployment"
      },
      "expected_reasoning": "The entire primary key is inherited as a foreign key from one parent entity, which Hannan treats as a basic entity rather than a weak entity."
    },
    {
      "id": "hannan_basic_lake_bubble",
      "mode": "data_first",
      "selected_table": "lake",
      "selected_columns": ["name", "elevation", "depth", "dam_height"],
      "expected_pattern": "basic_entity",
      "expected_visualisations": ["bubble_chart", "scatter_chart"],
      "expected_mapping": {
        "key": "lake.name",
        "x": "lake.elevation",
        "y": "lake.depth",
        "size": "lake.dam_height"
      },
      "expected_reasoning": "Lake has a primary key and multiple scalar attributes; three scalar attributes support a bubble chart."
    },
    {
      "id": "hannan_basic_organization_calendar",
      "mode": "data_first",
      "selected_table": "organization",
      "selected_columns": ["abbreviation", "established"],
      "expected_pattern": "basic_entity",
      "expected_visualisations": ["calendar_chart", "bar_chart", "word_cloud"],
      "expected_mapping": {
        "key": "organization.abbreviation",
        "date": "organization.established"
      },
      "expected_reasoning": "Organization has a non-foreign primary key and established is temporal scalar, enabling a calendar chart."
    },
    {
      "id": "hannan_weak_country_population_line",
      "mode": "data_first",
      "selected_table": "country_population",
      "selected_columns": ["country", "year", "population"],
      "expected_pattern": "weak_entity",
      "expected_visualisations": ["line_chart"],
      "expected_mapping": {
        "parent_key": "country_population.country",
        "child_key": "country_population.year",
        "y": "country_population.population"
      },
      "expected_reasoning": "Part of the primary key is a foreign key to country and the remaining primary-key column is local to the weak entity."
    },
    {
      "id": "hannan_weak_ethnic_group_grouped_bar",
      "mode": "data_first",
      "selected_table": "ethnic_group",
      "selected_columns": ["country", "name", "percentage"],
      "expected_pattern": "weak_entity",
      "expected_visualisations": ["grouped_bar_chart"],
      "expected_mapping": {
        "parent_key": "ethnic_group.country",
        "child_key": "ethnic_group.name",
        "value": "ethnic_group.percentage"
      },
      "expected_reasoning": "The table has a compound primary key in which country is a foreign key to country and name is the child key."
    },
    {
      "id": "hannan_one_many_airport_island_treemap",
      "mode": "data_first",
      "selected_table": "airport",
      "selected_columns": ["iata_code", "island", "elevation"],
      "expected_pattern": "one_many_relationship",
      "expected_visualisations": ["treemap", "circle_packing"],
      "expected_mapping": {
        "child_key": "airport.iata_code",
        "parent_key": "airport.island",
        "size": "airport.elevation"
      },
      "expected_reasoning": "The selected foreign key island is not part of airport's primary key, so it represents a one-many link from island to airport."
    },
    {
      "id": "hannan_many_many_encompasses_sankey",
      "mode": "data_first",
      "selected_table": "encompasses",
      "selected_columns": ["country", "continent", "percentage"],
      "expected_pattern": "many_many_relationship",
      "expected_visualisations": ["sankey_diagram"],
      "expected_mapping": {
        "source": "encompasses.country",
        "target": "encompasses.continent",
        "weight": "encompasses.percentage"
      },
      "expected_reasoning": "The primary key consists of two foreign keys to two separate parent tables, with percentage as a scalar relationship attribute."
    },
    {
      "id": "hannan_reflexive_many_many_borders_chord",
      "mode": "data_first",
      "selected_table": "borders",
      "selected_columns": ["country1", "country2", "length"],
      "expected_pattern": "reflexive_many_many_relationship",
      "expected_visualisations": ["chord_diagram", "network_chart"],
      "expected_mapping": {
        "source": "borders.country1",
        "target": "borders.country2",
        "weight": "borders.length"
      },
      "expected_reasoning": "The primary key consists of two foreign keys that both reference country, so the many-many relationship is reflexive."
    }
  ]
}
